# Optional overrides. Copy to .env and change what you need; everything has a
# default in src/common/config.py.
#
# docker compose reads this file too. Inside the containers, KAFKA_BOOTSTRAP,
# MONGO_URI and API_BASE_URL are always replaced with the service names from
# docker-compose.yml, so the localhost values below only matter when you run
# a script directly on your machine.
KAFKA_BOOTSTRAP=localhost:9092
TOPIC_EVENTS=clickstream
MONGO_URI=mongodb://localhost:27018
MONGO_DB=product_affinity
API_BASE_URL=http://localhost:8000

# Throughput and parallelism (changing KAFKA_PARTITIONS, SHUFFLE_PARTITIONS or
# STATE_STORE needs a fresh start: docker compose down -v)
KAFKA_PARTITIONS=6
# How long Kafka keeps events (ms). 86400000 = 24 hours.
KAFKA_RETENTION_MS=86400000
SHUFFLE_PARTITIONS=8
STATE_STORE=rocksdb
MAX_OFFSETS_PER_TRIGGER=0

# Synthetic data
EVENTS_PER_SECOND=20
MALFORMED_RATE=0.01
CROSS_CATEGORY_RATE=0.15
SCHEMA_VERSION=2
LEGACY_EVENT_RATE=0.15

# Streaming windows
WATERMARK=2 minutes
TRENDING_WINDOW=1 minute
CO_VIEW_GAP=2 minutes
COOCCURRENCE_WINDOW=1 minute
TRIGGER_INTERVAL=10 seconds
STARTING_OFFSETS=earliest

# Serving
TRENDING_LOOKBACK_MINUTES=30
PAIR_LOOKBACK_MINUTES=30
MIN_PAIR_COUNT=3
RETENTION_HOURS=48
CACHE_TTL_SECONDS=5
